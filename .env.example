# PostgreSQL development credentials; keep the password and URL in sync.
OPENSHIELD_POSTGRES_PASSWORD=replace-with-a-local-db-password
OPENSHIELD_DATABASE_URL=postgresql://openshield:replace-with-a-local-db-password@openshield-db:5432/openshield

# Optional nearby-host gateway connector (enable with: docker compose --profile gateway up)
OPENSHIELD_NODE_URL=http://openshield-node:8000
OPENSHIELD_GATEWAY_ID=home-gateway
OPENSHIELD_GATEWAY_HEARTBEAT_INTERVAL=30
OPENSHIELD_GATEWAY_SPOOL_PATH=/var/lib/openshield/gateway-spool.sqlite3

# Optional OpenWrt environment fallback. Prefer configuring router credentials in the dashboard.
OPENSHIELD_OPENWRT_URL=
OPENSHIELD_OPENWRT_USERNAME=
OPENSHIELD_OPENWRT_PASSWORD=

# Encrypts dashboard-managed router credentials at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPENSHIELD_SECRET_KEY=
# Optional old Fernet key during rotation; remove after all secrets are re-encrypted.
OPENSHIELD_SECRET_KEY_PREVIOUS=

# Separate connector token; set the same value on Node and Gateway Connector.
OPENSHIELD_GATEWAY_TOKEN=

# Optional administrative HTTP Basic authentication. Disabled by default for the residential profile.
OPENSHIELD_API_AUTH_ENABLED=false
OPENSHIELD_API_USERNAME=
OPENSHIELD_API_PASSWORD=

# DNS provider polling interval in seconds (0 disables background polling; default 60).
OPENSHIELD_DNS_POLL_INTERVAL_SECONDS=60


# Optional cloud AI. Disabled by default; also enable per OpenAI integration in the dashboard.
OPENSHIELD_CLOUD_AI_ENABLED=false


# P5 enforcement is disabled by default. Require admin auth, explicit policy and emergency-stop release.
OPENSHIELD_ENFORCEMENT_ENABLED=false
# Global autonomy ceiling: 0=observe, 1=approval only, 2-3=explicit policy automation.
OPENSHIELD_MAX_AUTONOMY_LEVEL=0

# Host address for publishing the Node API. Loopback is the safe default.
# Set to the Node's trusted-LAN IP only when LAN clients need direct access.
OPENSHIELD_PUBLISH_ADDRESS=127.0.0.1
