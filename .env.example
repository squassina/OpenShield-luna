# PostgreSQL development credentials; keep the password and URL in sync.
OPENSHIELD_POSTGRES_PASSWORD=replace-with-a-local-db-password
OPENSHIELD_DATABASE_URL=postgresql://openshield:replace-with-a-local-db-password@openshield-db:5432/openshield

# Optional nearby-host gateway connector (enable with: docker compose --profile gateway up)
OPENSHIELD_NODE_URL=http://openshield-node:8000
OPENSHIELD_GATEWAY_ID=home-gateway
OPENSHIELD_GATEWAY_HEARTBEAT_INTERVAL=30
OPENSHIELD_GATEWAY_SPOOL_PATH=/var/lib/openshield/gateway-spool.sqlite3

# Read-only OpenWrt rpcd/ubus access used by the nearby-host gateway connector.
# Use HTTPS where supported, or a trusted isolated management network.
OPENSHIELD_OPENWRT_URL=
OPENSHIELD_OPENWRT_USERNAME=
OPENSHIELD_OPENWRT_PASSWORD=
