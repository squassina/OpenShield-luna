#!/bin/sh
# Restricted rpcd plugin: expose only the IPv4 neighbor table to OpenShield.
. /usr/share/libubox/jshn.sh

case "$1" in
  list)
    printf '%s\n' '{"get_ipv4_neighbors":{}}'
    ;;
  call)
    case "$2" in
      get_ipv4_neighbors)
        neighbors="$(ip -4 neigh show 2>/dev/null)"
        json_init
        json_add_string neighbors "$neighbors"
        json_dump
        ;;
    esac
    ;;
esac
