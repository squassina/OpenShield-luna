# Loaded inside table inet fw4 by fw4's /etc/nftables.d/*.nft include.
set openshield_blocked_v4 {
    type ipv4_addr
    flags timeout
    timeout 1h
}

chain openshield_input {
    type filter hook input priority -10; policy accept;
    ip saddr @openshield_blocked_v4 drop
    ip daddr @openshield_blocked_v4 drop
}

chain openshield_forward {
    type filter hook forward priority -10; policy accept;
    ip saddr @openshield_blocked_v4 drop
    ip daddr @openshield_blocked_v4 drop
}
