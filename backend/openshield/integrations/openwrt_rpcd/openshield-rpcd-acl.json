{
  "openshield": {
    "description": "Least-privilege OpenShield router firewall actions",
    "read": {
      "ubus": {
        "system": [
          "board"
        ],
        "network.interface": [
          "dump"
        ],
        "openshield-firewall": [
          "status"
        ]
      }
    },
    "write": {
      "ubus": {
        "openshield-firewall": [
          "block_ip",
          "unblock_ip"
        ]
      }
    }
  }
}
